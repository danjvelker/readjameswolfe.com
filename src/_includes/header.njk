<header class="site-header">
  <div class="wrap header-inner">
    <div class="brand">
      <a href="/" class="brand-name-wrap">
        <span class="header-lantern" aria-hidden="true">
          <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
            <path d="M 25 17 Q 32 9 39 17" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            <path d="M 22 21 L 42 21 L 38 26 L 26 26 Z" fill="currentColor"/>
            <rect x="20" y="26" width="24" height="24" rx="5" fill="currentColor"/>
            <rect x="26" y="26" width="2" height="24" fill="var(--bg)" opacity="0.55"/>
            <rect x="36" y="26" width="2" height="24" fill="var(--bg)" opacity="0.55"/>
            <path d="M 32 33 C 36 37 36 41 32 44 C 28 41 28 37 32 33 Z" fill="var(--accent-bright)"/>
            <path d="M 24 50 L 40 50 L 37 55 L 27 55 Z" fill="currentColor"/>
          </svg>
        </span>
        <span class="brand-name">Read James Wolfe</span>
      </a>
      <p class="tagline">{{ settings.tagline }}</p>
    </div>
    <nav class="site-nav" aria-label="Primary">
      <a href="/articles/"{% if page.url == "/articles/" %} aria-current="page"{% endif %}>Articles</a>
      <a href="{{ settings.quotesUrl }}">Quotes</a>
      <a href="{{ settings.substackUrl }}" target="_blank" rel="noopener">Substack</a>
      <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
    </nav>
  </div>
</header>
