<aside class="sidebar" aria-label="Sidebar">

  <div class="sidebar-block author-blurb">
    <p>{{ settings.sidebarBlurb }}</p>
  </div>

  <div class="sidebar-block daily-quote-block">
    <div class="daily-quote" id="daily-quote">
      <!-- filled in by the small script below, picked fresh per visit -->
    </div>
    <p class="daily-quote-caption">Daily Quote</p>
    <a href="/gallery/" class="view-gallery-btn">View Gallery</a>
  </div>

  <div class="sidebar-block trending-block">
    <h2 class="sidebar-heading">Trending</h2>
    <ol class="trending-list" id="trending-list">
      <li class="trending-empty">No reader activity tracked yet — check back once a few visits come in.</li>
    </ol>
  </div>

</aside>

<script type="application/json" id="gallery-data">{{ gallery.gallery | dump | safe }}</script>
<script type="application/json" id="articles-index-data">{{ collections.articles | toArticleIndex | dump | safe }}</script>

<script>
(function () {
  // --- Daily Quote: a real per-visit random pick, done in the browser
  // since a static build can't "randomize" anything itself. ---
  function optimizedSrc(src, w) {
    var clean = (src || "").replace(/^\/+/, "");
    return "/img.php?src=" + encodeURIComponent(clean) + "&w=" + w;
  }

  var galleryEl = document.getElementById("gallery-data");
  var gallery = galleryEl ? JSON.parse(galleryEl.textContent) : [];
  var dailyQuoteEl = document.getElementById("daily-quote");

  if (dailyQuoteEl && gallery.length) {
    var pick = gallery[Math.floor(Math.random() * gallery.length)];
    dailyQuoteEl.innerHTML =
      '<a href="/gallery/" class="daily-quote-img-btn">' +
      '<img src="' + optimizedSrc(pick, 500) + '" alt="Quote graphic" class="quote-photo" ' +
      'onerror="this.style.display=\'none\'; this.nextElementSibling.style.display=\'flex\';">' +
      '<div class="quote-img-placeholder" style="display:none;"><span>Quote image</span></div>' +
      '</a>';
  }

  var galleryBtn = document.querySelector(".view-gallery-btn");
  if (galleryBtn && !gallery.length) {
    galleryBtn.setAttribute("aria-disabled", "true");
    galleryBtn.style.opacity = "0.4";
    galleryBtn.style.pointerEvents = "none";
  }

  // --- Trending: genuinely live data (real visitor click counts), so
  // this is the one thing on the page that still needs a fetch(). ---
  var indexEl = document.getElementById("articles-index-data");
  var articlesIndex = indexEl ? JSON.parse(indexEl.textContent) : [];
  var trendingList = document.getElementById("trending-list");

  if (trendingList && articlesIndex.length) {
    fetch("/content/click-counts.json", { cache: "no-store" })
      .then(function (res) { return res.ok ? res.json() : {}; })
      .catch(function () { return {}; })
      .then(function (counts) {
        var withCounts = articlesIndex.map(function (a) {
          return { title: a.title, slug: a.slug, clicks: counts[a.slug] || 0 };
        });
        withCounts.sort(function (a, b) { return b.clicks - a.clicks; });
        var topThree = withCounts.slice(0, 3);
        if (!topThree.some(function (a) { return a.clicks > 0; })) return; // leave default message
        trendingList.innerHTML = topThree.map(function (a) {
          return '<li><a href="/' + a.slug + '/">' + a.title + '</a></li>';
        }).join("");
      });
  }
})();
</script>
