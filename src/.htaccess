RewriteEngine On

# Canonical homepage: redirect /index.html to / so the URL bar never
# shows the filename. Runs before the article rewrite below.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ /? [L,R=301]

# Conventional URLs for the sitemap and RSS feed, even though they're
# actually generated by PHP under the hood (always current, no manual
# regeneration needed).
RewriteRule ^sitemap\.xml$ /sitemap.php [L]
RewriteRule ^feed\.xml$ /feed.php [L]

# Clean article URLs: readjameswolfe.com/some-article-slug
# quietly serves article-template.html?slug=some-article-slug behind the
# scenes, without changing what's shown in the browser's address bar.
# Only kicks in when nothing else already matches that path — real files
# and folders (index.html, about.html, admin/, content/, assets/, etc.)
# are left completely alone.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(admin|assets|content|scripts)
RewriteRule ^([a-zA-Z0-9-]+)/?$ /article.php?slug=$1 [L,QSA]
