RewriteEngine On

# Block access to the .git folder — it's a full copy of your repo
# history sitting in the web root as part of how deploys work here.
# Without this, it would be directly browsable/downloadable.
RedirectMatch 404 /\.git

# Canonical homepage: redirect /index.html to / so the URL bar never
# shows the filename. Runs before the article rewrite below.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ /? [L,R=301]

# Note: sitemap.xml, feed.xml, and clean article URLs (/some-slug) no
# longer need rewrite rules here — Eleventy generates them as real
# files/folders directly (e.g. sitemap.xml, feed.xml, and
# whenjesusturned29/index.html), so Apache serves them naturally
# without any rewriting. The old rules pointed at sitemap.php/feed.php/
# article.php, which no longer exist after the Eleventy cutover — that
# was quietly producing 404s until this fix.
